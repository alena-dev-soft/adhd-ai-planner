# Copy to .env.local and fill in. Never commit real values.
# Project origin only, e.g. https://<project-ref>.supabase.co (no /rest/v1/)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# server/tests only
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# optional: without it AI is disabled and the planner still works
OPENAI_API_KEY=
