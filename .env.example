# Copy to .env.local and fill in. Never commit real values.

# Supabase project origin, e.g. https://<project-ref>.supabase.co (no /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (safe for the browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: without it AI is disabled and the planner still works. Server-only.
OPENAI_API_KEY=

# --- Optional, scripts/tests only (never exposed to the browser) ---
# If NEXT_PUBLIC_SUPABASE_* are empty, next.config.ts falls back to these two.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
